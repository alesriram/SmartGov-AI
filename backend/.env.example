# Groq Cloud API Key (LLM Triage & Chatbot)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Alternative Multilingual & Vision LLM)
GEMINI_API_KEY=your_gemini_api_key_here

# Email Notification Service
# Option A (Recommended for Render Free Tier - bypasses cloud SMTP port block):
# Get free API key (300 emails/day) at https://brevo.com
BREVO_API_KEY=your_brevo_api_key_here

# Option B (Standard SMTP - works locally; blocked by Render Free Tier):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM=your_email@gmail.com

# Server Environment
PORT=8000
HOST=0.0.0.0
